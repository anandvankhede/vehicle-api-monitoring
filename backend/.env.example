# MongoDB Configuration
MONGO_URL=mongodb://localhost:27017
DATABASE_NAME=vehical_api_monitoring

# Response database (raw API responses) — READ-ONLY mapping to an existing remote DB.
# If missing/unreachable, the app still starts; dashboard graphs stay empty.
# RESPONSE_MONGO_URL=mongodb://user:password@host:port/your_db?authSource=your_db
# RESPONSE_DATABASE_NAME=pan
# Legacy env names PAN_MONGO_URL / PAN_DATABASE_NAME are also accepted.

# JWT Authentication
SECRET_KEY=supersecretkeychangeme
ALGORITHM=HS256
# Access token expires in 1440 minutes = 1 day (24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - Frontend URLs allowed to access API (JSON array format)
FRONTEND_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000"]
