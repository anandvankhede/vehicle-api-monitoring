# MongoDB Configuration
MONGO_URL=mongodb://localhost:27017
DATABASE_NAME=vehical_api_monitoring

# Response database (raw API responses) — READ-ONLY mapping to an existing remote DB.
# If missing/unreachable, the app still starts; dashboard graphs stay empty.
# RESPONSE_MONGO_URL=mongodb://user:password@host:port/your_db?authSource=your_db
# RESPONSE_DATABASE_NAME=pan
# Legacy env names PAN_MONGO_URL / PAN_DATABASE_NAME / PAN_COLLECTION_CACHE_SECONDS are also accepted.
#
# response_db read load limits (monitoring is read-only; these protect shared Mongo with live API)
# RESPONSE_DB_QUERY_MAX_MS=15000
# RESPONSE_DB_MAX_POOL_SIZE=5
# RESPONSE_DB_MAX_CONCURRENT_QUERIES=2
# RESPONSE_DB_COLLECTION_CACHE_SECONDS=60
# RESPONSE_DB_READ_PREFERENCE=secondaryPreferred

# JWT Authentication
SECRET_KEY=supersecretkeychangeme
ALGORITHM=HS256
# Access token expires in 1440 minutes = 1 day (24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - Frontend URLs allowed to access API
# JSON array OR comma-separated list both work.
# For VM deploy (frontend :3000, backend :5000), set PUBLIC_FRONTEND_URL to the
# exact URL users open in the browser, e.g. http://20.244.83.47:3000
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
# PUBLIC_FRONTEND_URL=http://YOUR_VM_IP:3000
