# Production build — copy to .env.production before `npm run build`
# Frontend is served on port 3000; backend API on port 5000.

# Replace YOUR_VM_IP with the VM public IP or hostname users open in the browser.
VITE_API_BASE_URL=http://YOUR_VM_IP:5000/api

# Dashboard background refresh (ms). Default production: 30000 (30s).
# VITE_DASHBOARD_POLL_MS=30000

# Graph popup live refresh while open (ms). Default: 5000 (5s).
# VITE_GRAPH_MODAL_POLL_MS=5000

# Client Activity / API Requests list refresh (ms). Default: 15000 (15s).
# VITE_ACTIVITY_POLL_MS=15000
