# Copy to .env.development (local dev) or .env.production (build/deploy)
# Only variables prefixed with VITE_ are exposed to the browser.

# Local Vite dev server (npm run dev) — backend on port 5000
# VITE_API_BASE_URL=http://localhost:5000/api

# Production VM (frontend :3000, backend :5000) — replace YOUR_VM_IP
# VITE_API_BASE_URL=http://YOUR_VM_IP:5000/api

# Production with domain
# VITE_API_BASE_URL=https://api.yourdomain.com/api
