# Copy to .env and set your backend API URL.
# Only variables prefixed with VITE_ are exposed to the browser.
# Restart the Vite dev server after changing this file.

VITE_API_BASE_URL=http://YOUR_BACKEND_HOST:5000/api

# Optional polling intervals (ms, minimum 5000)
# VITE_DASHBOARD_POLL_MS=15000
# VITE_GRAPH_MODAL_POLL_MS=5000
# VITE_ACTIVITY_POLL_MS=15000
